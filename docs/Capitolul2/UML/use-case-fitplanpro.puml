@startuml
title FitPlan Pro - Use-Case (imagine generală)
left to right direction
skinparam packageStyle rectangle

actor "Utilizator" as User
actor "Administrator" as Admin
Admin --|> User

rectangle "FitPlan Pro" as System {
  usecase "Autentificare" as UC_Login
  usecase "Înregistrare" as UC_Register
  usecase "Deconectare" as UC_Logout

  usecase "Vizualizare Dashboard\n(statistici calorii/progres)" as UC_Dashboard
  usecase "Gestionare mese\n(Adăugare/Actualizare/Ștergere)" as UC_Meals
  usecase "Gestionare antrenamente\n(Adăugare/Actualizare/Ștergere)" as UC_Workouts

  usecase "Cronometru antrenament" as UC_Timer
  usecase "Calculator BMI" as UC_BMI

  usecase "Export date (CSV)" as UC_Export
  usecase "Schimbare temă\n(light/dark)" as UC_Theme
  usecase "Schimbare limbă\n(RU/EN/RO)" as UC_Language

  usecase "Administrare utilizatori\n(vizualizare / schimbare rol / ștergere)" as UC_UserMgmt
}

User --> UC_Login
User --> UC_Register
User --> UC_Logout
User --> UC_Dashboard
User --> UC_Meals
User --> UC_Workouts
User --> UC_Timer
User --> UC_BMI
User --> UC_Export
User --> UC_Theme
User --> UC_Language

Admin --> UC_UserMgmt
UC_UserMgmt ..> UC_Dashboard : <<extend>>

UC_Dashboard ..> UC_Meals : <<include>>
UC_Dashboard ..> UC_Workouts : <<include>>

note right of UC_Export
  În aplicație exportul este declanșat din Dashboard
  și exportă în CSV lista de mese.
end note

@enduml
